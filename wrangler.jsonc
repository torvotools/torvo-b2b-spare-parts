{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "torvo-b2b-spare-parts",
  "compatibility_date": "2026-09-13",
  "main": "src/v2/cloudflare-worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/business-login",
      "/business-login/",
      "/business-login.html",
      "/torvo-build-sha.txt",
      "/torvo-build-manifest.json",
      "/torvo-build-manifest.txt"
    ]
  }
}
